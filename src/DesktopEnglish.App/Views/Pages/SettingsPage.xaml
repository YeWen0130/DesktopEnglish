<UserControl x:Class="DesktopEnglish.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="设置" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                       Text="修改提醒间隔后立即生效，无需重启程序。" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="提醒" />

                    <TextBlock Text="提醒间隔（分钟）" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ReminderInterval}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,12" />

                    <TextBlock Text="每日学习数量（上限）" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DailyWordCount}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,12" />

                    <TextBlock Text="每次提醒的单词数" Margin="0,0,0,4" />
                    <TextBox Text="{Binding WordsPerReminder}" Width="140" HorizontalAlignment="Left" />

                    <CheckBox Content="开启自动提醒（桌面通知）" IsChecked="{Binding NotificationEnabled}" />
                    <CheckBox Content="通知播放声音" IsChecked="{Binding SoundEnabled}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="启动" />
                    <CheckBox Content="开机自动启动" IsChecked="{Binding AutoStart}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="提醒状态" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Style="{StaticResource PrimaryButton}" Content="暂停提醒"
                                Command="{Binding PauseCommand}" />
                        <Button Content="恢复提醒" Command="{Binding ResumeCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="暂停仅在本次运行期间有效，重启后恢复提醒。" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="保存设置" Command="{Binding SaveCommand}" />
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding StatusMessage}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
