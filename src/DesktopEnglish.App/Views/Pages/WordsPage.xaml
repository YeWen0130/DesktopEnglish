<UserControl x:Class="DesktopEnglish.Views.WordsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitle}" Text="单词管理" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox Width="240" Margin="0,0,8,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Style="{StaticResource PrimaryButton}" Content="搜索"
                        Command="{Binding SearchCommand}" />
                <Button Content="新增单词" Click="OnAddClick" />
                <Button Content="导入文件" Click="OnImportClick" />
                <Button Content="删除选中" Click="OnDeleteClick" />
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedWord}"
                  MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="单词" Binding="{Binding WordText}" Width="140" />
                <DataGridTextColumn Header="音标" Binding="{Binding Phonetic}" Width="150" />
                <DataGridTextColumn Header="词性" Binding="{Binding PartOfSpeech}" Width="110" />
                <DataGridTextColumn Header="中文释义" Binding="{Binding Meaning}" Width="*" />
                <DataGridTextColumn Header="难度" Binding="{Binding Level}" Width="60" />
                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="上一页" Command="{Binding PreviousPageCommand}" />
            <Button Content="下一页" Command="{Binding NextPageCommand}" />
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0">
                <Run Text="第 " /><Run Text="{Binding Page, Mode=OneWay}" />
                <Run Text=" / " /><Run Text="{Binding TotalPages, Mode=OneWay}" /><Run Text=" 页" />
            </TextBlock>
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0"
                       Text="{Binding StatusMessage}" />
        </StackPanel>
    </Grid>
</UserControl>
