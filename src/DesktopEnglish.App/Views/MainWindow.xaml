<Window x:Class="DesktopEnglish.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="背单词"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Icon="pack://application:,,,/Resources/app.ico">

    <DockPanel>
        <!-- Navigation rail -->
        <Border DockPanel.Dock="Left" Width="180" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,18">
                <TextBlock Text="背单词" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="6,0,0,18" />

                <Button Content="学习概览" Click="OnDashboardClick" HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                <Button Content="单词管理" Click="OnWordsClick" HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                <Button Content="开始学习" Click="OnStudyClick" HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                <Button Content="设置" Click="OnSettingsClick" HorizontalContentAlignment="Left" Margin="0,0,0,6" />

                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="6,20,6,0"
                           Text="程序可在后台运行。关闭本窗口不会退出，提醒仍会按时出现；退出请使用托盘菜单。" />
            </StackPanel>
        </Border>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0" />
        </Border>

        <!-- Active page -->
        <ContentControl Content="{Binding CurrentPage}" Margin="20" />
    </DockPanel>
</Window>
