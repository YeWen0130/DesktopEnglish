<Window x:Class="DesktopEnglish.Views.WordEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="单词" Height="540" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SectionTitle}" Text="单词" />
            <TextBox x:Name="WordBox" Margin="0,0,0,12" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="音标" />
            <TextBox x:Name="PhoneticBox" Margin="0,0,0,12" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="词性" />
            <TextBox x:Name="PosBox" Margin="0,0,0,12" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="中文释义" />
            <TextBox x:Name="MeaningBox" Margin="0,0,0,12" Height="80"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="英文例句" />
            <TextBox x:Name="ExampleBox" Margin="0,0,0,12" Height="60"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />

            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="难度等级（1-10）" />
                    <TextBox x:Name="LevelBox" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="词库分类" />
                    <TextBox x:Name="CategoryBox" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="保存" Click="OnSaveClick" />
            <Button Content="取消" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
